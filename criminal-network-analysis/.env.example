# Root-level env file, read by docker-compose.yml.
# For local (non-Docker) development, use backend/.env.example and
# frontend/.env.example instead -- copy each into its own service directory.

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-before-any-real-deployment
