# Copy this file to .env and adjust values for your local setup.
# Never commit a real .env file or real secrets to source control.

# --- Application ---
APP_NAME="AI-Powered Criminal Network Analysis System"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# SQLite is used by default for the prototype so it runs with zero external
# services. Swap in a PostgreSQL URL for a production-style deployment, e.g.
# postgresql+psycopg2://ncrb:ncrb@localhost:5432/criminal_network
DATABASE_URL=sqlite:///./crime_network.db

# --- Security ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-before-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
