# Environment
NETRA_ENV=development
DEBUG=true

# API Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication
JWT_SECRET=dev-secret-change-in-production-12345678901234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (optional - leave empty for synthetic demo)
DATABASE_URL=

# Neo4j Configuration (optional - leave empty for synthetic demo)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Integration Mode (synthetic | database | neo4j)
INTEGRATION_MODE=synthetic

# Logging
LOG_LEVEL=INFO
